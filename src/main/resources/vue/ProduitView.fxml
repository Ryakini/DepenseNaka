<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<AnchorPane prefHeight="680.0" prefWidth="1150.0" stylesheets="@cssFile/style.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.ydev.depenseNaka.controlleur.ProduitControlleur">
    <children>
        <HBox spacing="15.0" AnchorPane.bottomAnchor="10.0" AnchorPane.leftAnchor="15.0" AnchorPane.rightAnchor="15.0" AnchorPane.topAnchor="0.0">
            <children>

                <!-- SECTION GAUCHE : Recherche Multicritère + Tableau -->
                <VBox spacing="10.0" HBox.hgrow="ALWAYS">
                    <children>

                        <!-- Recherche Multi-critères -->
                        <VBox spacing="8.0" styleClass="card">
                            <padding><Insets bottom="10.0" left="10.0" right="10.0" top="10.0" /></padding>
                            <children>
                                <HBox alignment="CENTER_LEFT" spacing="10.0">
                                    <children>
                                        <Label styleClass="bold, text-muted" text="Recherche multicritère" />
                                        <Button focusTraversable="false" onAction="#ouvrirGestionCategories" styleClass="accent, small" text="Gérer les Catégories">
                                            <graphic><FontIcon iconLiteral="fas-tags" iconSize="12" /></graphic>
                                        </Button>
                                    </children>
                                </HBox>
                                <HBox spacing="8.0">
                                    <children>
                                        <TextField fx:id="txtSearchId" promptText="N° Produit" HBox.hgrow="ALWAYS" />
                                        <TextField fx:id="txtSearchDesignation" promptText="Désignation" HBox.hgrow="ALWAYS" />
                                        <ComboBox fx:id="cbSearchCategorie" editable="true" promptText="Toutes les catégories" HBox.hgrow="ALWAYS" />
                                        <TextField fx:id="txtSearchTaille" promptText="Taille" prefWidth="100.0" />
                                        <ComboBox fx:id="cbSearchStatutActif" prefWidth="150.0" />
                                        <CheckBox fx:id="chkSearchDisponible" text="Disponible" />
                                        <Button onAction="#effectuerRecherche" styleClass="accent">
                                            <graphic><FontIcon iconLiteral="fas-search" iconSize="12" /></graphic>
                                        </Button>
                                        <Button onAction="#reinitialiserRecherche" styleClass="accent">
                                            <graphic><FontIcon iconLiteral="fas-undo" iconSize="12" /></graphic>
                                        </Button>
                                    </children>
                                </HBox>
                            </children>
                        </VBox>

                        <!-- Tableau des Produits -->
                        <TableView fx:id="tableProduits" styleClass="striped" VBox.vgrow="ALWAYS" HBox.hgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="colActions" prefWidth="60.0"  />
                                <TableColumn fx:id="colId" prefWidth="120.0" text="N° produit" />
                                <TableColumn fx:id="colNom" prefWidth="180.0" text="Désignation" />
                                <TableColumn fx:id="colCategorie" prefWidth="110.0" text="Catégorie" />
                                <TableColumn fx:id="colTaille" prefWidth="80.0" text="Taille" />
                                <TableColumn fx:id="colQuantite" prefWidth="75.0" text="Qté" />
                                <TableColumn fx:id="colPrixAchat" prefWidth="95.0" text="P. Achat" />
                                <TableColumn fx:id="colPrixVente" prefWidth="95.0" text="P. Vente" />
                                <TableColumn fx:id="colMarge" prefWidth="90.0" text="Marge" />
                                <TableColumn fx:id="colDisponible" prefWidth="80.0" text="Dispo." />
                            </columns>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                            </columnResizePolicy>
                        </TableView>
                        <!-- BARRE DE PAGINATION -->
                        <HBox alignment="CENTER_RIGHT" spacing="10.0" styleClass="card">
                            <padding><Insets bottom="8.0" left="12.0" right="12.0" top="8.0" /></padding>
                            <children>
                                <Label fx:id="lblInfoPagination" styleClass="text-muted" text="Page 1 sur 1 (0 éléments)" />
                                <HBox alignment="CENTER" spacing="5.0">
                                    <children>
                                        <!-- Nombre de lignes par page -->
                                        <HBox alignment="CENTER_LEFT" spacing="8.0" HBox.hgrow="ALWAYS">
                                            <children>
                                                <Label styleClass="text-muted" text="Afficher :" />
                                                <ComboBox fx:id="cbLignesParPage" prefWidth="80.0" />
                                                <Label styleClass="text-muted" text="par page" />
                                            </children>
                                        </HBox>
                                        <Button fx:id="btnPagePrecedente" onAction="#pagePrecedente" styleClass="accent, small">
                                            <graphic><FontIcon iconLiteral="fas-chevron-left" iconSize="12" /></graphic>
                                        </Button>
                                        <Label fx:id="lblPageCourante" styleClass="bold" text="1" />
                                        <Button fx:id="btnPageSuivante" onAction="#pageSuivante" styleClass="accent, small">
                                            <graphic><FontIcon iconLiteral="fas-chevron-right" iconSize="12" /></graphic>
                                        </Button>
                                    </children>
                                </HBox>
                            </children>
                        </HBox>
                    </children>
                </VBox>

                <!-- SECTION DROITE : Formulaire Produit -->
                <VBox prefWidth="340.0" spacing="12.0" styleClass="card">
                    <padding><Insets bottom="15.0" left="15.0" right="15.0" top="15.0" /></padding>
                    <children>
                        <HBox alignment="CENTER_LEFT" spacing="8.0">
                            <children>
                                <FontIcon iconLiteral="fas-box-open" iconSize="18" styleClass="icon-accent" />
                                <Label fx:id="lblFormTitre" styleClass="title-4" text="Nouveau Produit" />
                            </children>
                        </HBox>

                        <VBox spacing="8.0" VBox.vgrow="ALWAYS">
                            <children>
                                <VBox spacing="2.0">
                                    <children>
                                        <Label styleClass="bold" text="ID Produit" />
                                        <TextField fx:id="txtIdProduit" disable="true" promptText="Généré automatiquement" />
                                    </children>
                                </VBox>

                                <VBox spacing="2.0">
                                    <children>
                                        <Label styleClass="bold" text="Catégorie *" />
                                        <ComboBox fx:id="cbCategorieForm" editable="true" maxWidth="1.7976931348623157E308" promptText="Sélectionner une catégorie" />
                                    </children>
                                </VBox>

                                <VBox spacing="2.0">
                                    <children>
                                        <Label styleClass="bold" text="Désignation *" />
                                        <TextField fx:id="txtNomProduit" promptText="Nom du produit" />
                                    </children>
                                </VBox>

                                <HBox spacing="8.0">
                                    <children>
                                        <VBox spacing="2.0" HBox.hgrow="ALWAYS">
                                            <children>
                                                <Label styleClass="bold" text="Taille" />
                                                <TextField fx:id="txtTailleProduit" promptText="Ex: XL, 42..." />
                                            </children>
                                        </VBox>
                                        <VBox spacing="2.0" HBox.hgrow="ALWAYS">
                                            <children>
                                                <Label styleClass="bold" text="Quantité *" />
                                                <TextField fx:id="txtQuantite" promptText="0.0" />
                                            </children>
                                        </VBox>
                                    </children>
                                </HBox>

                                <HBox spacing="8.0">
                                    <children>
                                        <VBox spacing="2.0" HBox.hgrow="ALWAYS">
                                            <children>
                                                <Label styleClass="bold" text="Prix Achat *" />
                                                <TextField fx:id="txtPrixAchat" promptText="0.0" />
                                            </children>
                                        </VBox>
                                        <VBox spacing="2.0" HBox.hgrow="ALWAYS">
                                            <children>
                                                <Label styleClass="bold" text="Prix Vente *" />
                                                <TextField fx:id="txtPrixVente" promptText="0.0" />
                                            </children>
                                        </VBox>
                                    </children>
                                </HBox>

                                <HBox spacing="15.0">
                                    <children>
                                        <CheckBox fx:id="chkDisponible" selected="true" text="Disponible" />
                                        <CheckBox fx:id="chkActif" selected="true" text="Actif" />
                                    </children>
                                    <padding><Insets top="4.0" /></padding>
                                </HBox>

                                <VBox spacing="2.0" VBox.vgrow="ALWAYS">
                                    <children>
                                        <Label styleClass="bold" text="Description" />
                                        <TextArea fx:id="txtDescription" prefHeight="70.0" promptText="Détails du produit..." wrapText="true" />
                                    </children>
                                </VBox>
                            </children>
                        </VBox>

                        <!-- Boutons Formulaire -->
                        <HBox spacing="10.0">
                            <children>
                                <Button maxWidth="1.7976931348623157E308" onAction="#reinitialiserFormulaire" styleClass="flat" text="Réinitialiser" HBox.hgrow="ALWAYS" />
                                <Button fx:id="btnValider" maxWidth="1.7976931348623157E308" onAction="#validerFormulaire" styleClass="success" text="Valider" HBox.hgrow="ALWAYS">
                                    <graphic><FontIcon iconLiteral="fas-check" iconSize="14" /></graphic>
                                </Button>
                            </children>
                        </HBox>
                    </children>
                </VBox>

            </children>
        </HBox>
    </children>
</AnchorPane>