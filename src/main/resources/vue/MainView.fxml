<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<?import java.net.URL?>
<AnchorPane fx:id="mainContainer" prefHeight="720.0" prefWidth="1280.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.ydev.depenseNaka.controlleur.MainViewController">
   <stylesheets>
      <URL value="@cssFile/style.css" />
   </stylesheets>
   <children>

      <!-- Barre de Titre (Drag & Drop + Contrôles) -->
      <HBox fx:id="titleBar" alignment="CENTER_RIGHT" prefHeight="35.0" spacing="10" styleClass="bg-subtle" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <padding>
            <Insets left="15.0" right="10.0" />
         </padding>
         <children>
            <HBox alignment="CENTER_LEFT" spacing="8.0" HBox.hgrow="ALWAYS">
               <children>
                  <FontIcon iconLiteral="fas-file-invoice-dollar" iconSize="18" />
                  <Label styleClass="title-4" text="DepenseNaka" />
               </children>
            </HBox>
            <Button focusTraversable="false" onAction="#handleMinimize" styleClass="flat, small">
               <graphic><FontIcon iconLiteral="fas-minus" iconSize="12" /></graphic>
            </Button>
            <Button focusTraversable="false" onAction="#handleMaximize" styleClass="flat, small">
               <graphic><FontIcon iconLiteral="fas-expand" iconSize="12" /></graphic>
            </Button>
            <Button focusTraversable="false" onAction="#handleClose" styleClass="flat, danger, small">
               <graphic><FontIcon iconLiteral="fas-times" iconSize="12" /></graphic>
            </Button>
         </children>
      </HBox>

      <!-- Header Info Bar (Burger, Titre Vue, Horloge, Thème, Profil) -->
      <HBox alignment="CENTER_LEFT" prefHeight="50.0" spacing="15.0" styleClass="border-subtle" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="35.0">
         <padding>
            <Insets left="15.0" right="20.0" />
         </padding>
         <children>
            <Button fx:id="btnBurger" focusTraversable="false" onAction="#toggleSidebar" styleClass="flat">
               <graphic><FontIcon iconLiteral="fas-bars" iconSize="16" /></graphic>
            </Button>
            <Label fx:id="lblVueActuelle" styleClass="title-3" text="Tableau de bord" HBox.hgrow="ALWAYS" />
            <HBox alignment="CENTER_RIGHT" spacing="15.0" HBox.hgrow="ALWAYS">
               <children>
                  <Label fx:id="lblDateTime" styleClass="text-muted" text="--/--/---- --:--" />
                  <Button fx:id="btnThemeToggle" onAction="#toggleTheme" styleClass="flat">
                     <graphic><FontIcon fx:id="iconTheme" iconLiteral="fas-moon" iconSize="16" /></graphic>
                  </Button>
                  <HBox alignment="CENTER" spacing="8.0">
                     <children>
                        <FontIcon iconLiteral="fas-user-circle" iconSize="20" />
                        <Label fx:id="lblUtilisateur" styleClass="bold" text="Utilisateur Connecté" />
                     </children>
                  </HBox>
               </children>
            </HBox>
         </children>
      </HBox>

      <!-- Sidebar (Barre latérale de menu) -->
      <VBox fx:id="sidebar" prefWidth="240.0" spacing="8.0" styleClass="bg-subtle" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.topAnchor="85.0">
         <padding>
            <Insets bottom="15.0" left="10.0" right="10.0" top="15.0" />
         </padding>
         <children>
            <Button fx:id="btnDashboard" alignment="BASELINE_LEFT" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleMenuChange" prefHeight="40.0" style="-fx-cursor: hand;" styleClass="flat" text="Tableau de bord">
               <graphic><FontIcon iconLiteral="fas-chart-pie" iconSize="16" /></graphic>
            </Button>
            <Button fx:id="btnClient" alignment="BASELINE_LEFT" mnemonicParsing="false" onAction="#handleMenuChange" prefHeight="40.0" prefWidth="230.0" style="-fx-cursor: hand;" styleClass="flat" text="Clients">
               <graphic><FontIcon iconLiteral="fas-users" iconSize="16" /></graphic>
            </Button>
            <Button fx:id="btnProduits" alignment="BASELINE_LEFT" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleMenuChange" prefHeight="40.0" style="-fx-cursor: hand;" styleClass="flat" text="Produits">
               <graphic><FontIcon iconLiteral="fas-box" iconSize="16" /></graphic>
            </Button>
            <Button fx:id="btnVentes" alignment="BASELINE_LEFT" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleMenuChange" prefHeight="40.0" style="-fx-cursor: hand;" styleClass="flat" text="Ventes">
               <graphic><FontIcon iconLiteral="fas-shopping-cart" iconSize="16" /></graphic>
            </Button>
            <Button fx:id="btnFactures" alignment="BASELINE_LEFT" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleMenuChange" prefHeight="40.0" style="-fx-cursor: hand;" styleClass="flat" text="Factures">
               <graphic><FontIcon iconLiteral="fas-file-invoice" iconSize="16" /></graphic>
            </Button>
            <Button fx:id="btnCommandes" alignment="BASELINE_LEFT" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleMenuChange" prefHeight="40.0" style="-fx-cursor: hand;" styleClass="flat" text="Commandes">
               <graphic><FontIcon iconLiteral="fas-truck" iconSize="16" /></graphic>
            </Button>
            <Button fx:id="btnUtilisateurs" alignment="BASELINE_LEFT" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleMenuChange" prefHeight="40.0" style="-fx-cursor: hand;" styleClass="flat" text="Utilisateurs">
               <graphic><FontIcon iconLiteral="fas-users" iconSize="16" /></graphic>
            </Button>
            <Button fx:id="btnStatistiques" alignment="BASELINE_LEFT" mnemonicParsing="false" onAction="#handleMenuChange" prefHeight="40.0" prefWidth="230.0" style="-fx-cursor: hand;" styleClass="flat" text="Statistiques">
               <graphic><FontIcon iconLiteral="fas-chart-line" iconSize="16" /></graphic>
            </Button>
            <Button fx:id="btnParametre" alignment="BASELINE_LEFT" mnemonicParsing="false" onAction="#handleMenuChange" prefHeight="40.0" prefWidth="230.0" style="-fx-cursor: hand;" styleClass="flat" text="Paramètres">
               <graphic><FontIcon iconLiteral="fas-cog" iconSize="16" /></graphic>
            </Button>

            <VBox VBox.vgrow="ALWAYS" />


            <Button fx:id="btnDeconnexion" alignment="BASELINE_LEFT" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleDeconnexion" prefHeight="40.0" style="-fx-cursor: hand; -fx-font-weight: bold;"  styleClass="flat, danger" text="Déconnexion">
               <graphic><FontIcon iconLiteral="fas-sign-out-alt" iconSize="16" /></graphic>
            </Button>
         </children>
      </VBox>

      <!-- Dynamic Content Area -->
      <VBox fx:id="contentArea" alignment="CENTER" spacing="10.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="240.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="85.0">
         <children>
            <Label styleClass="text-muted" text="Sélectionnez un menu dans la barre latérale." />
         </children>
      </VBox>

   </children>
</AnchorPane>