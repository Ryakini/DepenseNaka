<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="705.0" prefWidth="646.0" spacing="12.0" stylesheets="@cssFile/style.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.ydev.depenseNaka.controlleur.FactureEditControlleur">
    <padding><Insets bottom="15" left="15" right="15" top="15" /></padding>

    <!-- En-tête avec Numéro de Facture et Client -->
    <VBox spacing="4.0">
        <Label styleClass="title-3" text="Modification de la Facture" />
        <HBox spacing="20.0">
            <Label fx:id="lblNumeroFacture" style="-fx-font-weight: bold;" text="N° : -" />
            <Label fx:id="lblNomClient" style="-fx-font-weight: bold;" text="Client : -" />
        </HBox>
    </VBox>

    <!-- Formulaire d'ajout d'article -->
    <HBox alignment="BOTTOM_LEFT" spacing="10.0" styleClass="card">
        <padding><Insets bottom="10" left="10" right="10" top="10" /></padding>
        <VBox HBox.hgrow="ALWAYS">
            <Label text="Produit" />
            <ComboBox fx:id="cbProduits" maxWidth="Infinity" prefHeight="26.0" prefWidth="205.0" promptText="Sélectionner..." />
        </VBox>
        <Region prefHeight="43.0" prefWidth="15.0" />
        <VBox prefWidth="90.0">
            <Label text="Quantité" />
            <TextField fx:id="txtQuantite" text="1" />
        </VBox>
        <Region prefHeight="43.0" prefWidth="58.0" />
        <Button onAction="#handleAjouterProduit" prefHeight="26.0" prefWidth="75.0" styleClass="accent" text="Ajouter" />
    </HBox>

    <!-- Table des articles de la facture -->
    <TableView fx:id="tableLignes" editable="true" styleClass="striped" maxHeight="400.0" prefHeight="400.0" prefWidth="688.0" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colProduit" prefWidth="200.0" text="Designation" />
            <TableColumn fx:id="colPrix" prefWidth="90.0" text="Prix U." />
            <TableColumn fx:id="colQte" prefWidth="70.0" text="Qté" />
            <TableColumn fx:id="colTotal" prefWidth="100.0" text="Total" />
            <TableColumn fx:id="colAction" prefWidth="80.0" text="Action" />
        </columns>
        <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY" /></columnResizePolicy>
    </TableView>

    <!-- Zone de paiement : Avance, Reste, Nouveau montant et Mode de paiement -->
    <HBox alignment="CENTER_LEFT" prefHeight="70.0" prefWidth="616.0" spacing="15.0" styleClass="card">
        <padding><Insets bottom="10" left="10" right="10" top="10" /></padding>
        <VBox alignment="CENTER_LEFT" prefHeight="66.0" prefWidth="180.0" spacing="4.0">
            <Label fx:id="lblAvance" style="-fx-font-weight: bold;" text="Avance : 0.00 Ar" />
            <Label fx:id="lblReste" style="-fx-font-size: 14px; -fx-text-fill: #e74c3c;" text="Reste : 0.00 Ar" />
        </VBox>
        <Region HBox.hgrow="ALWAYS" />
        <VBox prefWidth="120.0">
            <Label text="Saisir montant" />
            <TextField fx:id="txtMontantPayer" promptText="0.00" />
        </VBox>
        <VBox prefWidth="150.0">
            <Label text="Mode de paiement" />
            <ComboBox fx:id="cbModePaiement" prefWidth="150.0" promptText="Sélectionner..." />
        </VBox>
    </HBox>

    <!-- Pied de page : Total & Enregistrement -->
    <HBox alignment="CENTER_RIGHT" spacing="15.0">
        <Label fx:id="lblTotalFacture" style="-fx-font-weight: bold; -fx-font-size: 14px;" text="Total : 0.00 Ar" />
        <Region HBox.hgrow="ALWAYS" />
        <Button onAction="#handleAnnuler" styleClass="flat" text="Annuler" />
        <Button onAction="#handleSauvegarder" styleClass="success" text="Enregistrer les modifications" />
    </HBox>
</VBox>