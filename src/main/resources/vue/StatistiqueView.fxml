<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import java.net.URL?>
<VBox spacing="10.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.ydev.depenseNaka.controlleur.StatistiqueControlleur">
    <stylesheets>
        <URL value="@cssFile/style.css" />
    </stylesheets>
    <padding>
        <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
    </padding>

    <!-- Filtre Global de Période -->
    <HBox spacing="10.0" alignment="CENTER_LEFT">
        <Label text="Période du :" />
        <DatePicker fx:id="dpDebut" />
        <Label text="au :" />
        <DatePicker fx:id="dpFin" />
        <Button text="Actualiser" onAction="#handleActualiser" styleClass="accent"/>
    </HBox>

    <TabPane tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">
        <!-- ONGLET 1: Évolutions (LineChart) -->
        <Tab text="Évolution Générale">
            <VBox spacing="10.0">
                <padding>
                    <Insets top="10.0" />
                </padding>
                <LineChart fx:id="chartEvolution" title="Évolution des Ventes, Commandes et Clients" VBox.vgrow="ALWAYS">
                    <xAxis>
                        <CategoryAxis label="Date" />
                    </xAxis>
                    <yAxis>
                        <NumberAxis label="Valeur / Volume" />
                    </yAxis>
                </LineChart>
            </VBox>
        </Tab>

        <!-- ONGLET 2: Marges et Bénéfices (Tableau + BarChart) -->
        <Tab text="Marges et Bénéfices">
            <SplitPane dividerPositions="0.5" VBox.vgrow="ALWAYS">
                <items>
                    <VBox spacing="5.0">
                        <Label text="Tableau des Marges par Commande" style="-fx-font-weight: bold;" />
                        <TableView fx:id="tvMarges" styleClass="striped" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="colMargeCommande" text="ID Commande" prefWidth="100.0" />
                                <TableColumn fx:id="colMargeClient" text="Client" prefWidth="120.0" />
                                <TableColumn fx:id="colMargeVente" text="Total Vente" prefWidth="90.0" />
                                <TableColumn fx:id="colMargeDepense" text="Total Dépenses" prefWidth="100.0" />
                                <TableColumn fx:id="colMargeNet" text="Marge Nette" prefWidth="90.0" />
                                <TableColumn fx:id="colMargePourcentage" text="Marge (%)" prefWidth="80.0" />
                            </columns>
                        </TableView>
                    </VBox>

                    <VBox spacing="5.0">
                        <BarChart fx:id="chartMarges" title="Ventes vs Dépenses par Commande" VBox.vgrow="ALWAYS">
                            <xAxis>
                                <CategoryAxis label="Commande" />
                            </xAxis>
                            <yAxis>
                                <NumberAxis label="Montant" />
                            </yAxis>
                        </BarChart>
                    </VBox>
                </items>
            </SplitPane>
        </Tab>

        <!-- ONGLET 3: Meilleurs Clients -->
        <Tab text="Meilleurs Clients">
            <VBox spacing="10.0">
                <padding>
                    <Insets top="10.0" />
                </padding>
                <Label text="Classement des Clients par Montant des Commandes" style="-fx-font-size: 14px; -fx-font-weight: bold;" />
                <TableView fx:id="tvMeilleursClients" styleClass="striped" VBox.vgrow="ALWAYS" HBox.hgrow="ALWAYS">
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                    <columns>
                        <TableColumn fx:id="colClientId" text="ID Client" prefWidth="100.0" />
                        <TableColumn fx:id="colClientNom" text="Nom &amp; Prénom" prefWidth="250.0" />
                        <TableColumn fx:id="colClientNbCommandes" text="Nb Commandes" prefWidth="120.0" />
                        <TableColumn fx:id="colClientTotalDepense" text="Montant Cumulé" prefWidth="150.0" />
                    </columns>
                </TableView>
            </VBox>
        </Tab>

        <!-- ONGLET 4: Marge mensuelle -->
        <Tab text="Marge Mensuelle">
            <content>
                <VBox spacing="10.0">
                    <padding>
                        <Insets top="15.0" right="15.0" bottom="15.0" left="15.0" />
                    </padding>
                    <TableView fx:id="tvMargesMensuelles" styleClass="striped" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="colMoisAnnee" text="Mois / Année" prefWidth="180.0" />
                            <TableColumn fx:id="colMoisVente" text="Total Ventes" prefWidth="150.0" />
                            <TableColumn fx:id="colMoisDepense" text="Total Dépenses" prefWidth="150.0" />
                            <TableColumn fx:id="colMoisMargeNette" text="Marge Nette" prefWidth="150.0" />
                            <TableColumn fx:id="colMoisPourcentage" text="Marge (%)" prefWidth="120.0" />
                        </columns>
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                        </columnResizePolicy>
                    </TableView>
                </VBox>
            </content>
        </Tab>
    </TabPane>
</VBox>