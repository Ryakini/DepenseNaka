<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<?import java.net.URL?>
<AnchorPane prefHeight="650.0" prefWidth="1100.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.ydev.depenseNaka.controlleur.ClientControlleur">
    <stylesheets>
        <URL value="@cssFile/style.css" />
    </stylesheets>
    <children>
        <HBox spacing="15.0" AnchorPane.bottomAnchor="15.0" AnchorPane.leftAnchor="15.0" AnchorPane.rightAnchor="15.0" AnchorPane.topAnchor="0.0">
            <children>

                <!-- SECTION GAUCHE : Recherche Multi-critères + Tableau -->
                <VBox spacing="10.0" HBox.hgrow="ALWAYS">
                    <children>

                        <!-- Barre de recherche multi-critères -->
                        <VBox spacing="8.0" styleClass="card">
                            <padding><Insets bottom="10.0" left="10.0" right="10.0" top="10.0" /></padding>
                            <children>
                                <Label styleClass="bold, text-muted" text="Recherche multi-critères" />
                                <HBox spacing="8.0">
                                    <children>
                                        <TextField fx:id="txtSearchId" promptText="CLI-0001" HBox.hgrow="ALWAYS" />
                                        <TextField fx:id="txtSearchNom" promptText="Nom" HBox.hgrow="ALWAYS" />
                                        <TextField fx:id="txtSearchPrenom" promptText="Prénom" HBox.hgrow="ALWAYS" />
                                        <TextField fx:id="txtSearchTelephone" promptText="Téléphone" HBox.hgrow="ALWAYS" />
                                        <TextField fx:id="txtSearchAdresse" promptText="Adresse" HBox.hgrow="ALWAYS" />
                                        <Button focusTraversable="false" onAction="#reinitialiserRecherche" styleClass="accent, small">
                                            <graphic><FontIcon iconLiteral="fas-sync-alt" iconSize="12" /></graphic>
                                        </Button>
                                    </children>
                                </HBox>
                            </children>
                        </VBox>

                        <!-- Tableau des clients -->
                        <TableView fx:id="tableClients" styleClass="striped" VBox.vgrow="ALWAYS" HBox.hgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="colActions" prefWidth="100.0" />
                                <TableColumn fx:id="colId" prefWidth="100.0" text="N° Client" />
                                <TableColumn fx:id="colNom" prefWidth="150.0" text="Nom" />
                                <TableColumn fx:id="colPrenom" prefWidth="150.0" text="Prénom" />
                                <TableColumn fx:id="colTelephone" prefWidth="130.0" text="Téléphone" />
                                <TableColumn fx:id="colAdresse" prefWidth="180.0" text="Adresse" />
                            </columns>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                            </columnResizePolicy>
                        </TableView>
                    </children>
                </VBox>

                <!-- SECTION DROITE : Formulaire d'ajout / modification -->
                <VBox prefWidth="320.0" spacing="15.0" styleClass="card">
                    <padding><Insets bottom="15.0" left="15.0" right="15.0" top="15.0" /></padding>
                    <children>
                        <HBox alignment="CENTER_LEFT" spacing="8.0">
                            <children>
                                <FontIcon iconLiteral="fas-user-edit" iconSize="18" styleClass="icon-accent" />
                                <Label fx:id="lblFormTitre" styleClass="title-4" text="Nouveau Client" />
                            </children>
                        </HBox>

                        <VBox spacing="10.0" VBox.vgrow="ALWAYS">
                            <children>
                                <VBox spacing="3.0">
                                    <children>
                                        <Label styleClass="bold" text="N° client" />
                                        <TextField fx:id="txtIdClient" disable="true" promptText="Généré automatiquement" />
                                    </children>
                                </VBox>

                                <VBox spacing="3.0">
                                    <children>
                                        <Label styleClass="bold" text="Nom *" />
                                        <TextField fx:id="txtNom" promptText="Saisir le nom" />
                                    </children>
                                </VBox>

                                <VBox spacing="3.0">
                                    <children>
                                        <Label styleClass="bold" text="Prénom" />
                                        <TextField fx:id="txtPrenom" promptText="Saisir le prénom" />
                                    </children>
                                </VBox>

                                <VBox spacing="3.0">
                                    <children>
                                        <Label styleClass="bold" text="Téléphone" />
                                        <TextField fx:id="txtTelephone" promptText="Saisir le téléphone" />
                                    </children>
                                </VBox>

                                <VBox spacing="3.0">
                                    <children>
                                        <Label styleClass="bold" text="Adresse" />
                                        <TextField fx:id="txtAdresse" promptText="Saisir l'adresse" />
                                    </children>
                                </VBox>
                            </children>
                        </VBox>

                        <!-- Boutons du formulaire -->
                        <HBox spacing="10.0">
                            <children>
                                <Button alignment="CENTER" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#reinitialiserFormulaire" styleClass="flat" text="Réinitialiser" HBox.hgrow="ALWAYS" />
                                <Button alignment="CENTER" maxWidth="1.7976931348623157E308" mnemonicParsing="false" defaultButton="true" onAction="#validerFormulaire" styleClass="success" text="Valider" HBox.hgrow="ALWAYS">
                                    <graphic><FontIcon iconLiteral="fas-check" iconSize="14" /></graphic>
                                </Button>
                            </children>
                        </HBox>
                    </children>
                </VBox>

            </children>
        </HBox>
    </children>
</AnchorPane>