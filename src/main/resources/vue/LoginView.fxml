<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox prefHeight="500.0" prefWidth="450.0" style="-fx-background-color: #2b303b;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.ydev.depenseNaka.controlleur.LoginControlleur">
    <stylesheets>
        <URL value="@cssFile/style.css" />
    </stylesheets>

    <!-- Barre de titre personnalisée (Style identique à la fenêtre principale) -->
    <HBox alignment="CENTER_LEFT" prefHeight="40.0" style="-fx-background-color: #323846; -fx-padding: 0 0 0 15;">
        <!-- Logo et Titre -->
        <FontIcon iconLiteral="fas-file-invoice-dollar" iconSize="18" />
        <Label style="-fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14px;" text="DepenseNaka">
            <HBox.margin>
                <Insets left="8.0" />
            </HBox.margin>
        </Label>

        <Region HBox.hgrow="ALWAYS" />

        <!-- Boutons de contrôle de la fenêtre -->
        <HBox alignment="CENTER_RIGHT" spacing="0.0">
            <Button fx:id="btnMinimiser" onAction="#handleMinimiser" styleClass="window-control-btn" style="-fx-background-color: transparent; -fx-cursor: hand; -fx-padding: 8 12;">
                <graphic>
                    <FontIcon iconLiteral="fas-minus" iconSize="12" />
                </graphic>
            </Button>
            <Button fx:id="btnFermer" onAction="#handleFermer" styleClass="window-control-btn-close, danger">
                <graphic>
                    <FontIcon iconLiteral="fas-times" iconSize="14"/>
                </graphic>
            </Button>
        </HBox>
    </HBox>

    <!-- Conteneur principal avec la carte de connexion -->
    <VBox alignment="CENTER" VBox.vgrow="ALWAYS">
        <padding>
            <Insets bottom="30.0" left="40.0" right="40.0" top="20.0" />
        </padding>

        <!-- Carte centrale avec bordure arrondie -->
        <VBox alignment="CENTER" spacing="20.0" maxWidth="380.0" style="-fx-background-color: #343a46; -fx-border-color: #434b5a; -fx-border-radius: 10; -fx-background-radius: 10; -fx-border-width: 1;">
            <padding>
                <Insets bottom="40.0" left="30.0" right="30.0" top="40.0" />
            </padding>

            <!-- Titres -->
            <VBox alignment="CENTER" spacing="5.0">
                <Label text="Connexion" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: white;" />
                <Label text="Gestion de Stock &amp; Facturation" style="-fx-font-size: 13px; -fx-text-fill: #a0a6b5;" />
            </VBox>

            <VBox spacing="15.0" alignment="CENTER_LEFT" maxWidth="Infinity">
                <VBox.margin>
                    <Insets top="10.0" />
                </VBox.margin>

                <!-- Champ Nom d'utilisateur -->
                <VBox spacing="6.0" maxWidth="Infinity">
                    <Label text="Nom d'utilisateur (Pseudo) :" style="-fx-text-fill: #e1e4ea; -fx-font-weight: bold;" />
                    <TextField fx:id="txtPseudo" promptText="Saisir votre pseudo" prefHeight="38.0" style="-fx-background-color: #2b303b; -fx-text-fill: white; -fx-border-color: #4f586b; -fx-border-radius: 4; -fx-background-radius: 4;" />
                </VBox>

                <!-- Champ Mot de passe -->
                <VBox spacing="6.0" maxWidth="Infinity">
                    <Label text="Mot de passe :" style="-fx-text-fill: #e1e4ea; -fx-font-weight: bold;" />
                    <PasswordField fx:id="txtMdp" promptText="••••••••" prefHeight="38.0" style="-fx-background-color: #2b303b; -fx-text-fill: white; -fx-border-color: #4f586b; -fx-border-radius: 4; -fx-background-radius: 4;" />
                </VBox>
            </VBox>

            <!-- Message d'erreur -->
            <Label fx:id="lblErreur" textFill="#ff6b6b" wrapText="true" visible="false" alignment="CENTER" maxWidth="Infinity" />

            <!-- Bouton de connexion -->
            <Button text="Se connecter" defaultButton="true" onAction="#handleLogin" maxWidth="Infinity" prefHeight="40.0" style="-fx-background-color: #5272a0; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 4; -fx-cursor: hand; -fx-font-size: 14px;" />
        </VBox>
    </VBox>
</VBox>