<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import java.net.URL?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<AnchorPane prefHeight="650.0" prefWidth="1100.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.ydev.depenseNaka.controlleur.ParametreControlleur">
    <stylesheets>
        <URL value="@cssFile/style.css" />
    </stylesheets>
    <children>

        <TabPane fx:id="conteneurPane" tabClosingPolicy="UNAVAILABLE"
                 AnchorPane.bottomAnchor="15.0"
                 AnchorPane.leftAnchor="15.0"
                 AnchorPane.rightAnchor="15.0"
                 AnchorPane.topAnchor="15.0">
            <tabs>

                <!-- ONGLET 1 : Importation des Produits -->
                <Tab text="Importation des Produits">
                    <VBox spacing="10.0">
                        <padding><Insets bottom="10.0" left="10.0" right="10.0" top="10.0" /></padding>
                        <children>
                            <!-- Barre d'outils et sélection de fichier -->
                            <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="card">
                                <padding><Insets bottom="10.0" left="10.0" right="10.0" top="10.0" /></padding>
                                <children>
                                    <Button onAction="#handleChoisirFichier" styleClass="accent" text="Parcourir...">
                                        <graphic><FontIcon iconLiteral="fas-folder-open" iconSize="14" /></graphic>
                                    </Button>
                                    <Label fx:id="lblNomFichier" styleClass="bold" text="Aucun fichier sélectionné" HBox.hgrow="ALWAYS" />

                                    <Button fx:id="btnChargerFichier" disable="true" onAction="#handleChargerContenu" styleClass="accent" text="Charger le fichier">
                                        <graphic><FontIcon iconLiteral="fas-file-import" iconSize="14" /></graphic>
                                    </Button>
                                </children>
                            </HBox>

                            <!-- Tableau de prévisualisation -->
                            <TableView fx:id="tableImportProduits" styleClass="striped" VBox.vgrow="ALWAYS">
                                <columns>
                                    <TableColumn fx:id="colImpNom" prefWidth="150.0" text="Nom Produit" />
                                    <TableColumn fx:id="colImpCategorie" prefWidth="120.0" text="Catégorie" />
                                    <TableColumn fx:id="colTaille" prefWidth="100.0" text="Taille" />
                                    <TableColumn fx:id="colImpPrixAchat" prefWidth="100.0" text="Prix Achat" />
                                    <TableColumn fx:id="colImpPrixVente" prefWidth="100.0" text="Prix Vente" />
                                    <TableColumn fx:id="colImpQte" prefWidth="80.0" text="Quantité" />
                                    <TableColumn fx:id="colImpDispo" prefWidth="80.0" text="Disponible" />
                                    <TableColumn fx:id="colImpStatut" prefWidth="180.0" text="Statut Sauvegarde" />
                                </columns>
                                <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY" /></columnResizePolicy>
                            </TableView>

                            <!-- Barre d'action basse -->
                            <HBox alignment="CENTER_RIGHT" spacing="10.0">
                                <children>
                                    <ProgressIndicator fx:id="progressImport" prefHeight="25.0" prefWidth="25.0" visible="false" />
                                    <Button onAction="#handleAnnulerImportation" styleClass="danger" text="Annuler" />
                                    <Button fx:id="btnSauvegarderBase" disable="true" onAction="#handleSauvegarderEnBase" styleClass="success" text="Sauvegarder dans la Base">
                                        <graphic><FontIcon iconLiteral="fas-database" iconSize="14" /></graphic>
                                    </Button>
                                </children>
                            </HBox>
                        </children>
                    </VBox>
                </Tab>

                <!-- ONGLET 2 : Synchronisation Base de Données -->
                <Tab fx:id="tabSynchronisation" text="Synchronisation Base de Données">
                    <VBox spacing="15.0">
                        <padding><Insets bottom="15.0" left="15.0" right="15.0" top="15.0" /></padding>
                        <children>
                            <VBox spacing="10.0" styleClass="card">
                                <padding><Insets bottom="12.0" left="12.0" right="12.0" top="12.0" /></padding>
                                <children>
                                    <Label styleClass="title-3" text="Configuration de la Synchronisation Email &amp; OneDrive" />
                                    <GridPane hgap="10.0" vgap="10.0">
                                        <columnConstraints>
                                            <ColumnConstraints prefWidth="160.0" />
                                            <ColumnConstraints hgrow="ALWAYS" />
                                        </columnConstraints>
                                        <rowConstraints>
                                            <RowConstraints />
                                            <RowConstraints />
                                        </rowConstraints>
                                        <children>
                                            <Label text="Adresse Email Destinataire :" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                                            <TextField fx:id="txtEmailUser" promptText="exemple@gmail.com" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                                            <Label text="Code Application Google :" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                                            <PasswordField fx:id="txtCodeGoogleApp" promptText="Mot de passe d'application Google (16 caractères)" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                                        </children>
                                    </GridPane>
                                    <HBox alignment="CENTER_RIGHT" spacing="10.0">
                                        <Button onAction="#handleEnregistrerConfigSync" styleClass="accent" text="Enregistrer les paramètres" />
                                    </HBox>
                                </children>
                            </VBox>

                            <VBox spacing="10.0" styleClass="card" VBox.vgrow="ALWAYS">
                                <padding><Insets bottom="12.0" left="12.0" right="12.0" top="12.0" /></padding>
                                <children>
                                    <Label styleClass="title-3" text="Exécution Manuelle" />
                                    <Label text="La vérification automatique s'exécute mensuellement et vous avertira 15 minutes après le démarrage si nécessaire." styleClass="text-muted" />
                                    <HBox alignment="CENTER_LEFT" spacing="15.0">
                                        <children>
                                            <Button fx:id="btnLancerSync" onAction="#handleLancerSyncManuelle" styleClass="success" text="Lancer la synchronisation maintenant">
                                                <graphic><FontIcon iconLiteral="fas-sync" iconSize="14" /></graphic>
                                            </Button>
                                            <ProgressIndicator fx:id="progressSync" prefHeight="25.0" prefWidth="25.0" visible="false" />
                                            <Label fx:id="lblStatutSync" text="Dernière synchro : Inconnue" />
                                        </children>
                                    </HBox>
                                </children>
                            </VBox>
                        </children>
                    </VBox>
                </Tab>

                <!-- ONGLET 3 : Mise à Jour de l'Application -->
                <Tab fx:id="tabUpdate" text="Mise à Jour">
                    <VBox spacing="15.0">
                        <padding><Insets bottom="15.0" left="15.0" right="15.0" top="15.0" /></padding>
                        <children>
                            <VBox spacing="12.0" styleClass="card">
                                <padding><Insets bottom="12.0" left="12.0" right="12.0" top="12.0" /></padding>
                                <children>
                                    <Label styleClass="title-3" text="Informations Version &amp; Dépôt" />
                                    <HBox alignment="CENTER_LEFT" spacing="10.0">
                                        <Label styleClass="bold" text="Version actuelle :" />
                                        <Label fx:id="lblVersionActuelle" styleClass="accent" text="v1.0.0" />
                                    </HBox>
                                    <VBox spacing="5.0">
                                        <Label text="URL du dépôt Git (Mise à jour) :" />
                                        <TextField fx:id="txtUrlGit" promptText="https://github.com/votre-compte/votre-depot.git" />
                                    </VBox>
                                    <HBox alignment="CENTER_RIGHT" spacing="10.0">
                                        <Button fx:id="btnTelechargerMAJ" onAction="#handleTelechargerMaj" styleClass="accent" text="Vérifier et Télécharger la mise à jour">
                                            <graphic><FontIcon iconLiteral="fas-download" iconSize="14" /></graphic>
                                        </Button>
                                    </HBox>
                                    <ProgressBar fx:id="progressMAJ" maxWidth="Infinity" progress="0.0" visible="false" />
                                    <Label fx:id="lblStatutMAJ" text="" />
                                </children>
                            </VBox>
                        </children>
                    </VBox>
                </Tab>

            </tabs>
        </TabPane>
    </children>
</AnchorPane>